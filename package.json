{
  "name": "rim-messenger",
  "version": "4.1.8-iteration.182",
  "private": true,
  "type": "module",
  "description": "RIM messenger — Zladen community platform, personalized social feed and imperial administration controls",
  "scripts": {
    "test": "node --test --test-concurrency=1 tests/*.test.js",
    "check": "node scripts/check-project.mjs",
    "check:syntax": "node scripts/check-syntax.mjs",
    "verify": "npm run check && npm run check:syntax && npm test && npm run test:e2e",
    "audit:html": "node scripts/audit-innerhtml.mjs",
    "test:e2e": "node scripts/run-e2e.mjs",
    "test:e2e:relay": "node --test tests/manual-e2e-supabase-relay-two-account.mjs",
    "build:cloudflare": "node scripts/build-cloudflare.mjs",
    "deploy:cloudflare": "npm run deploy:worker",
    "preview:cloudflare": "npm run build:cloudflare && npx --yes wrangler@4.165.0 dev",
    "build:pages": "npm run build:cloudflare",
    "deploy:worker": "npm run build:cloudflare && npm run deploy:wrangler",
    "deploy:wrangler": "npx --yes wrangler@4.165.0 deploy"
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "dependencies": {
    "@open-e2ee/signal-protocol-sdk": "14.7.0",
    "idb": "8.0.3",
    "@supabase/supabase-js": "2.49.8"
  },
  "devDependencies": {
    "esbuild": "0.27.0"
  }
}
